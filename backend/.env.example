# ==================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU BACKEND - NEUFOOD (.env.example)
# Tạo file .env cục bộ: cp .env.example .env
# ==================================================

# 1. Cấu hình ứng dụng Flask (App Environment)
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# 2. Bảo mật & Xác thực JWT (Security & Authentication)
# Lưu ý: Thay đổi SECRET_KEY thành chuỗi bí mật ngẫu nhiên trong môi trường production!
SECRET_KEY=neufood_super_secret_jwt_key_please_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. Cơ sở dữ liệu (PostgreSQL Database)
# Chạy cục bộ: postgresql://neufood_user:neufood_password@localhost:5432/neufood_db
# Chạy qua Docker container: postgresql://neufood_user:neufood_password@database:5432/neufood_db
DATABASE_URL=postgresql://neufood_user:neufood_password@localhost:5432/neufood_db

# Cơ sở dữ liệu phục vụ chạy Integration Test (Tùy chọn)
TEST_DATABASE_URL=postgresql://neufood_user:neufood_password@localhost:5432/neufood_api_test

# 4. Redis Cache & Token Blacklist (Tier 1 Blacklist Storage)
# Chạy cục bộ: redis://localhost:6379/0
# Chạy qua Docker container: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# 5. Phân quyền truy cập tài nguyên (CORS Allowed Origins - danh sách ngăn cách bởi dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 6. Giới hạn tần suất gọi API (Rate Limiting)
RATELIMIT_DEFAULT=200/day;50/hour

# 7. Quản lý tệp tải lên (File Uploads)
UPLOAD_FOLDER=app/uploads
MAX_CONTENT_LENGTH=16777216

# 8. Cấu hình Trợ lý ảo AI Chatbot (Google AI Studio / Gemini API)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_HISTORY_TTL_SECONDS=1800
CHAT_MAX_HISTORY_MESSAGES=10
# 9. Cấu hình gửi Email OTP qua Gmail (SMTP)
# Hướng dẫn tạo mật khẩu ứng dụng Gmail (App Password):
# 1. Truy cập https://myaccount.google.com/security
# 2. Bật "Xác minh 2 bước" (2-Step Verification) nếu chưa bật
# 3. Vào https://myaccount.google.com/apppasswords
# 4. Đặt tên ứng dụng (ví dụ: NEUFood) -> Nhấn Tạo
# 5. Copy chuỗi mật khẩu 16 chữ số (bỏ khoảng cách) dán vào SMTP_PASSWORD bên dưới:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME="NEUFood - Canteen NEU"
SMTP_USE_TLS=true
